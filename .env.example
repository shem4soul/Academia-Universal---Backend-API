# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (web app, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Public base URL used to build links to uploaded files
PUBLIC_URL=http://localhost:4000
# Web app URL — Paystack returns customers to $FRONTEND_URL/payment/callback
FRONTEND_URL=http://localhost:5173
# Deep link the mobile app opens after Paystack checkout
MOBILE_CALLBACK_URL=academiauniversal://payment/callback

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=academia
DB_PASSWORD=academia
DB_NAME=academia_universal
# Auto-create tables from the models. Keep true for local development; set false in production.
DB_SYNC=true
# Log every SQL query (noisy). Slow queries and errors are always logged.
DB_LOGGING=false
DB_SLOW_QUERY_MS=500
# Set true for managed Postgres that requires SSL (Render, Railway, Supabase, RDS…)
DB_SSL=false

# Auth — use long random strings in production
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# One-time codes (password reset / verification)
OTP_TTL_MINUTES=10
# Development only: return the code in the API response so you can test without email/SMS
EXPOSE_OTP_IN_RESPONSE=true

# Paystack — https://dashboard.paystack.com/#/settings/developers
# Use sk_test_/pk_test_ keys while developing. The webhook URL to set in the dashboard is:
#   https://<your-api-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN
# Amount (₦) charged to verify a new card; refunded automatically. Paystack's minimum is 50.
PAYSTACK_CARD_VERIFICATION_AMOUNT=50
PAYSTACK_TIMEOUT_MS=15000
# Only change for testing against a mock server
# PAYSTACK_BASE_URL=https://api.paystack.co
# Monthly Pro price (₦)
PRO_PRICE=5000

# Logging
# error | warn | info | http | verbose | debug
LOG_LEVEL=debug
# Write rotating JSON log files (logs/app-YYYY-MM-DD.log, logs/error-YYYY-MM-DD.log)
LOG_TO_FILE=true
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# Admin console (separate admin app). Admins can only sign in through it, with an authenticator app.
# Browser origin(s) of the admin app — sign-in from any other site is refused, and these are added to CORS.
ADMIN_ORIGINS=http://localhost:5174
ADMIN_2FA_REQUIRED=true
ADMIN_ACCESS_TTL=10m
ADMIN_REFRESH_TTL=8h
ADMIN_SESSION_MAX_HOURS=12
# Optional: only these IPs/CIDRs may use admin accounts, e.g. 102.89.0.0/16,41.58.10.4 (empty = any)
ADMIN_IP_ALLOWLIST=
ADMIN_LOCKOUT_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
# Encrypts stored 2FA secrets. Set a long random value in production (changing it later resets everyone's 2FA).
TOTP_ENCRYPTION_KEY=
